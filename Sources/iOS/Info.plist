<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Apple Polish Viewer</string>
	<key>CFBundleDisplayName</key>
	<string>Apple Polish</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Apple Polish connects to your own Mac on this network to show its media list and thumbnails.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Apple Polish lists the photos and videos on this iPhone by size so you can choose which ones to delete. Nothing leaves your device.</string>
	<key>NSCameraUsageDescription</key>
	<string>Apple Polish scans the pairing QR code shown on your Mac. Nothing is recorded.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pcmenke.applepolish.pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>applepolish</string>
			</array>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_applepolish._tcp</string>
	</array>
</dict>
</plist>
