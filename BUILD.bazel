load("@rules_apple//apple:macos.bzl", "macos_application", "macos_unit_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# Data model and the Messages-library reader. No UI, so it is unit-testable.
swift_library(
    name = "PolishCore",
    srcs = glob(["Sources/PolishCore/*.swift"]),
    linkopts = ["-lsqlite3"],
    module_name = "PolishCore",
)

swift_library(
    name = "AppSources",
    srcs = glob(["Sources/App/*.swift"]),
    copts = ["-parse-as-library"],
    module_name = "ApplePolishApp",
    deps = [":PolishCore"],
)

macos_application(
    name = "ApplePolish",
    bundle_id = "com.pcmenke.applepolish",
    bundle_name = "Apple Polish",
    infoplists = ["Sources/App/Info.plist"],
    minimum_os_version = "14.0",
    deps = [":AppSources"],
)

swift_library(
    name = "PolishCoreTestSources",
    testonly = True,
    srcs = ["Tests/PolishCoreTests.swift"],
    module_name = "PolishCoreTests",
    deps = [":PolishCore"],
)

macos_unit_test(
    name = "PolishCoreTests",
    minimum_os_version = "14.0",
    deps = [":PolishCoreTestSources"],
)
